<view class="container">
  <view class="card">
    <view class="title">设备数量确认</view>
    <view class="muted" style="margin-top:6rpx;">请店员在签字前确认数量正确，数量不可涂改。</view>
  </view>

  <view class="card">
    <view class="field" wx:for="{{countsList}}" wx:key="label">
      <text class="field-label">{{item.label}}</text>
      <input class="input" type="number" data-index="{{index}}" value="{{item.value}}" bindinput="onCount" placeholder="数量" />
    </view>
  </view>

  <view class="card">
    <text class="field-label">无线信号能覆盖整个店铺且信号较强</text>
    <view class="row">
      <view class="tag {{wifiCovers === 'yes' ? 'tag-ok' : ''}}" data-value="yes" bindtap="onWifi">是</view>
      <view class="tag {{wifiCovers === 'no' ? 'tag-warn' : ''}}" data-value="no" bindtap="onWifi">否</view>
    </view>
  </view>

  <view class="card">
    <text class="field-label">IT支持服务评价</text>
    <view class="row">
      <view wx:for="{{ratings}}" wx:key="value" class="tag {{rating === item.value ? 'tag-ok' : ''}}"
            data-value="{{item.value}}" bindtap="onRating">{{item.label}}</view>
    </view>
    <view class="field" style="margin-top:16rpx;">
      <text class="field-label">具体原因或其他建议</text>
      <textarea class="input" value="{{comment}}" bindinput="onComment" style="height:120rpx;" />
    </view>
  </view>

  <view class="btn" bindtap="onSave">保存（待同步）</view>
</view>

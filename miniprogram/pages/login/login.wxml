<view class="container">
  <view class="card">
    <view class="title">Kering 店铺巡检</view>
    <view class="muted" style="margin-top:8rpx;">首次使用请绑定员工账号</view>
  </view>

  <view class="card" wx:if="{{needBind}}">
    <view class="field">
      <text class="field-label">用户名</text>
      <input class="input" data-field="username" value="{{username}}" bindinput="onInput" placeholder="员工用户名" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input class="input" password data-field="password" value="{{password}}" bindinput="onInput" placeholder="密码" />
    </view>
    <view wx:if="{{error}}" class="tag tag-warn" style="margin-bottom:12rpx;">{{error}}</view>
    <view class="btn {{loading ? 'btn-disabled' : ''}}" bindtap="onBind">
      {{loading ? '绑定中…' : '绑定并登录'}}
    </view>
  </view>

  <view class="card" wx:else>
    <view class="muted">正在登录…</view>
  </view>
</view>

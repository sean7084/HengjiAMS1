<view class="container">
  <view class="card">
    <view class="title">生成巡检报告</view>
    <view class="muted" style="margin-top:6rpx;">
      服务端生成《Report Per Store.xlsx》与 Photo 压缩包（需联网）。
    </view>
    <view class="btn {{generating ? 'btn-disabled' : ''}}" bindtap="generate">
      {{generating ? '生成中…' : '生成报告'}}
    </view>
    <view wx:if="{{generatedAt}}" class="muted" style="margin-top:12rpx;">生成时间：{{generatedAt}}</view>
  </view>

  <view class="card" wx:if="{{reportUrl}}">
    <view class="btn" bindtap="openReport">下载 / 打开 Excel 报告</view>
    <view class="btn" style="background:#07A162;" bindtap="shareReport">分享报告到微信</view>
    <view class="btn" style="background:#79CB23;" wx:if="{{photoZipUrl}}" bindtap="openZip">下载 Photo 压缩包</view>
  </view>
</view>

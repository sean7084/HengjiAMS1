/* Global styles for the Kering inspection mini program. */
page {
  background: #f2f2f2;
  font-size: 28rpx;
  color: #222;
}

.container {
  padding: 24rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title {
  font-size: 34rpx;
  font-weight: 600;
}

.muted {
  color: #888;
  font-size: 24rpx;
}

.btn {
  background: #4f6228;
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  text-align: center;
  margin-top: 20rpx;
}

.btn-disabled {
  background: #b7bf9f;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  color: #555;
  margin-bottom: 8rpx;
  display: block;
}

.input {
  background: #f7f7f7;
  border-radius: 10rpx;
  padding: 16rpx;
}

.tag {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  background: #eef1e6;
  color: #4f6228;
}

.tag-warn {
  background: #fdeeee;
  color: #b60205;
}

.tag-ok {
  background: #e9f6ec;
  color: #0e8a16;
}
